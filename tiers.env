# Model for each tier. audit.sh reads this file. Override any value in the environment.
# Run `omp models anthropic` to list the IDs that omp can use.

# Mechanical work: inventory, dependency data.
: "${AUDIT_MODEL_FAST:=anthropic/claude-haiku-5-5}"
# Most hunting passes.
: "${AUDIT_MODEL_WORK:=anthropic/claude-sonnet-5-5}"
# Context building, spec compliance, contracts, the final report.
: "${AUDIT_MODEL_DEEP:=anthropic/claude-opus-5-5}"
# Independent verification. Use a model other than the ones that found the issues.
: "${AUDIT_MODEL_CHECK:=anthropic/claude-fable-5-1}"

# Limits for each stage. When a stage reaches a limit, omp stops and the run fails.
: "${AUDIT_MAX_TIME:=90m}"
: "${AUDIT_COST_FAST:=3}"
: "${AUDIT_COST_WORK:=15}"
: "${AUDIT_COST_DEEP:=40}"
: "${AUDIT_COST_CHECK:=25}"
